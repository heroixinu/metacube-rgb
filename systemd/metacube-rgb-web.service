# Managed by metacube-rgb-dkms installer
[Unit]
Description=MetaCube RGB authenticated local web controller
After=multi-user.target systemd-modules-load.service
ConditionPathExists=/etc/metacube-rgb/web.token

[Service]
Type=simple
ExecStartPre=/usr/sbin/modprobe metacube_ambient
EnvironmentFile=-/etc/default/metacube-rgb-web
ExecStart=/usr/local/sbin/metacube-rgb web
Restart=on-failure
RestartSec=4s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/metacube-rgb

[Install]
WantedBy=multi-user.target
